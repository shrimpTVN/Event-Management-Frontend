# API Target for real Spring Boot backend (used by 'npm run dev')
VITE_API_TARGET=http://localhost:8080

# API Target for Mock Server (used by 'npm run dev:mock')
VITE_MOCK_API_TARGET=http://localhost:8088

# Base URL prefix for Axios requests (defaults to /api)
VITE_API_BASE_URL=/api

# Required when using the real backend. Copy this file to .env.local, set the
# same OAuth Client ID as the backend GOOGLE_CLIENT_ID, then restart Vite.
# Do not put a Google client secret in any VITE_* variable.
VITE_GOOGLE_CLIENT_ID=
